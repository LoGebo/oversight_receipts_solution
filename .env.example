# Classifier keys; leave both empty to run from the committed warm cache only. Never commit the filled .env.
# --provider defaults to openrouter when only OPENROUTER_API_KEY is set; with ANTHROPIC_API_KEY set (alone or
# with both) it is anthropic. Pass --provider openrouter|anthropic to choose explicitly.
# OpenRouter key (the one Oversight supplies; https://openrouter.ai/api/v1, default model anthropic/claude-haiku-5.5).
OPENROUTER_API_KEY=
# Anthropic API key (direct Messages API, model claude-haiku-5-5).
ANTHROPIC_API_KEY=
